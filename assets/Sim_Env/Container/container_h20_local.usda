                    customData = {
                        float3 default = (1, 1, 1)
                    }
                    displayGroup = "Variant_Options"
                    displayName = "Color Tint"
                )
                asset inputs:normalmap_texture = @container_h20_cloud/textures/T_Plastic_Normal_1k.png@ (
                    colorSpace = "raw"
                    displayGroup = "Normal"
                    displayName = "Normal Map"
                )
                asset inputs:ORM_texture = @container_h20_cloud/textures/T_Plastic_Gray_A_ORM.png@ (
                    colorSpace = "raw"
                    displayGroup = "Variant_Options"
                    displayName = "ORM Map"
                )
                token outputs:mdl:displacement.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container/Shader.outputs:out>
                token outputs:mdl:surface.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container/Shader.outputs:out>
                token outputs:mdl:volume.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container/Shader.outputs:out>

                def Shader "Shader"
                {
                    uniform token info:implementationSource = "sourceAsset"
                    uniform asset info:mdl:sourceAsset = @container_h20_cloud/materials/Plastic_B.mdl@
                    uniform token info:mdl:sourceAsset:subIdentifier = "Plastic_B"
                    float inputs:albedo_add = 0 (
                        customData = {
                            float default = 0
                            dictionary soft_range = {
                                float max = 1
                                float min = -1
                            }
                        }
                        displayGroup = "Albedo"
                        displayName = "Albedo Add"
                        doc = "Adds a constant value to the diffuse color "
                        hidden = false
                    )
                    float inputs:albedo_add.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:albedo_add>
                    float inputs:albedo_brightness = 1 (
                        customData = {
                            float default = 1
                            dictionary soft_range = {
                                float max = 1
                                float min = 0
                            }
                        }
                        displayGroup = "Albedo"
                        displayName = "Albedo Brightness"
                        doc = "Multiplier for the diffuse color "
                        hidden = false
                    )
                    float inputs:albedo_brightness.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:albedo_brightness>
                    float inputs:albedo_desaturation = 0 (
                        customData = {
                            float default = 0
                            dictionary soft_range = {
                                float max = 1
                                float min = 0
                            }
                        }
                        displayGroup = "Albedo"
                        displayName = "Albedo Desaturation"
                        doc = "Desaturates the diffuse color"
                        hidden = false
                    )
                    float inputs:albedo_desaturation.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:albedo_desaturation>
                    asset inputs:ao_texture = @@ (
                        colorSpace = "raw"
                        customData = {
                            asset default = @@
                            dictionary displayGroup = {
                                string state = "closed"
                            }
                        }
                        displayGroup = "AO"
                        displayName = "Ambient Occlusion Map"
                        doc = "The Ambient Occlusion texture for the material"
                        hidden = false
                    )
                    float inputs:bump_factor = 1 (
                        customData = {
                            float default = 1
                            dictionary soft_range = {
                                float max = 1
                                float min = 0
                            }
                        }
                        displayGroup = "Normal"
                        displayName = "Normal Map Strength"
                        doc = "Strength of normal map."
                        hidden = false
                    )
                    float inputs:bump_factor.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:bump_factor>
                    color3f inputs:diffuse_color_constant = (0.9082218, 0.11113997, 0.11113997) (
                        customData = {
                            float3 default = (0, 0, 0)
                        }
                        displayGroup = "Albedo"
                        displayName = "Base Color"
                        doc = "This is the base color"
                        hidden = false
                    )
                    asset inputs:diffuse_texture = @@ (
                        colorSpace = "sRGB"
                        customData = {
                            asset default = @@
                        }
                        displayGroup = "Albedo"
                        displayName = "Albedo Map"
                        hidden = false
                    )
                    asset inputs:diffuse_texture.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:diffuse_texture>
                    color3f inputs:diffuse_tint = (1, 1, 1) (
                        customData = {
                            float3 default = (1, 1, 1)
                        }
                        displayGroup = "Albedo"
                        displayName = "Color Tint"
                        doc = "When enabled, this color value is multiplied over the final albedo color"
                        hidden = false
                    )
                    color3f inputs:diffuse_tint.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:diffuse_tint>
                    asset inputs:normalmap_texture = @container_h20_cloud/textures/T_Plastic_Normal_1k.png@ (
                        colorSpace = "raw"
                        displayGroup = "Normal"
                        displayName = "Normal Map"
                        doc = "Enables the usage of the normalmap texture"
                        hidden = false
                    )
                    asset inputs:normalmap_texture.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:normalmap_texture>
                    float inputs:opacity_constant = 1 (
                        customData = {
                            dictionary displayGroup = {
                                string state = "closed"
                            }
                        }
                        displayGroup = "Opacity"
                        displayName = "Opacity Amount"
                        doc = "Opacity value between 0 and 1, when Opacity Map is not valid"
                        hidden = false
                    )
                    int inputs:opacity_mode = 1 (
                        customData = {
                            dictionary displayGroup = {
                                string state = "closed"
                            }
                        }
                        displayGroup = "Opacity"
                        displayName = "Opacity Mono Source"
                        doc = "Determines how to lookup opacity from the supplied texture. mono_alpha, mono_average, mono_luminance, mono_maximum"
                        hidden = false
                        renderType = "::base::mono_mode"
                        sdrMetadata = {
                            string __SDR__enum_value = "mono_average"
                            string options = "mono_alpha:0|mono_average:1|mono_luminance:2|mono_maximum:3"
                        }
                    )
                    asset inputs:ORM_texture = @container_h20_cloud/textures/T_Plastic_ORM_1k.png@ (
                        colorSpace = "raw"
                        displayGroup = "Reflectivity"
                        displayName = "ORM Map"
                        doc = "Texture that hae Occlusion, Roughness and Metallic map stored in the respective r, g and b channels"
                        hidden = false
                    )
                    asset inputs:ORM_texture.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:ORM_texture>
                    float inputs:reflection_roughness_constant = 0.17999999 (
                        customData = {
                            float default = 0.5
                            dictionary range = {
                                float max = 1
                                float min = 0
                            }
                        }
                        displayGroup = "Reflectivity"
                        displayName = "Roughness Amount"
                        doc = "Higher roughness values lead to more blurry reflections"
                        hidden = false
                    )
                    float inputs:reflection_roughness_constant.connect = </RootNode/container_h20_inst/Looks/opaque__plastic__container.inputs:reflection_roughness_constant>
                    token outputs:out
                    uniform token ui:nodegraph:node:expansionState = "open"
                }
            }
        }

        def Scope "colliders"
        {
            token visibility = "invisible"

            def Cube "Cube" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
                bool physics:collisionEnabled = 1
                double size = 1
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (0.6, 0.4, 0.008)
                double3 xformOp:translate = (0, 0, 0.0045)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "Cube_01" (
