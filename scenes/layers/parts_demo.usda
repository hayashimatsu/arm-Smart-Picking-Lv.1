#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    over "object" (
        active = false
    )
    {
    }

    def Xform "Parts"
    {
        def "flange_round_galvanized" (
            prepend references = @../../parts/usd/flange_round.usd@
            variants = {
                string finish = "galvanized"
            }
        )
        {
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (-0.7, -0.09, 0.5952)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

