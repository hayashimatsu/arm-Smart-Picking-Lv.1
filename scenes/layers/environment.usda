    def Scope "EnvLooks"
    {
        def Material "tex_concrete_floor_02"
        {
            token outputs:surface.connect = </World/EnvLooks/tex_concrete_floor_02/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/EnvLooks/tex_concrete_floor_02/diffuse.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </World/EnvLooks/tex_concrete_floor_02/rough.outputs:r>
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "uvScale"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </World/EnvLooks/tex_concrete_floor_02/stReader.outputs:result>
                float2 inputs:scale = (25, 25)
                float2 outputs:result
            }

            def Shader "diffuse"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/mnt/data/Lin(sda)/About Yolo/assets/textures/concrete_floor_02/concrete_floor_02_diff_2k.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/EnvLooks/tex_concrete_floor_02/uvScale.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "rough"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/mnt/data/Lin(sda)/About Yolo/assets/textures/concrete_floor_02/concrete_floor_02_rough_2k.jpg@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/EnvLooks/tex_concrete_floor_02/uvScale.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }
        }

