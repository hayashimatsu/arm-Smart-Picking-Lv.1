#usda 1.0
(
    "Switchable lighting + floor. Generated by scripts/build_env_usd.py - edit the script, not this file."
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def DomeLight "LookDome" (
        variants = {
            string backdrop = "hidden"
            string brightness = "normal"
            string hdri = "photo_studio_loft_hall"
            string rotation = "rot_0"
        }
        prepend variantSets = ["hdri", "brightness", "rotation", "backdrop"]
    )
    {
        float inputs:intensity
        asset inputs:texture:file
        custom bool visibleInPrimaryRay
        float xformOp:rotateZ
        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
        variantSet "hdri" = {
            "abandoned_workshop" (
                customData = {
                    string split = "test_ood"
                }
            ) {
                asset inputs:texture:file = @/mnt/data/Lin(sda)/About Yolo/assets/hdri/2k/abandoned_workshop_2k.hdr@

            }
            "aircraft_workshop_01" (
                customData = {
